# ==============================================================================
# OpenTelemetry & Grafana Configuration Template
# ==============================================================================

# The only telemetry variable. Service names and OTLP endpoints are constants in
# backend/telemetry/ and bluesky_ingestion_jetstream/telemetry/, not env vars.
#
# Authentication header. Format must be: Authorization=Basic%20<base64_encoded_string>
# Note: The space must be URL-encoded as '%20' or the Python exporter will fail.
# Leave it unset to run without telemetry — setup_telemetry() no-ops rather than crashing.
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<PLACEHOLDER_BASE64_INSTANCE_ID_COLON_TOKEN>

# ==============================================================================
# Railway / Infrastructure Configuration
# ==============================================================================

# AWS Credentials
# Required by bluesky_ingestion_jetstream (Glue, S3, DynamoDB) and data_platform/aws/.
# Also required by the backend's /query route, which runs Athena and writes results to S3.
# Note: Locally, these are usually read from ~/.aws, but they must be explicitly set on Railway.
AWS_ACCESS_KEY_ID=<your_aws_access_key_id>
AWS_SECRET_ACCESS_KEY=<your_aws_secret_access_key>

# AWS Session Token
# OPTIONAL: Only uncomment and provide this if you are using temporary/STS credentials.
# Leave blank or commented out if you are using a long-lived IAM user's static keys.
# AWS_SESSION_TOKEN=<your_temporary_session_token>

# Security / CORS Configuration
# Comma-separated list of allowed origins parsed by backend/main.py.
# In production on Railway, set this to your deployed frontend's URL (e.g., https://my-app.vercel.app).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM Calls
OPENAI_API_KEY=<your_openai_api_key>

# ==============================================================================
# Query Result Delivery
# ==============================================================================

# The Gmail account /query results are mailed from, and an app password for it
# (Google Account -> Security -> App passwords; requires 2-Step Verification).
# Gmail forces From to the authenticated account, so these must be the same address.
GMAIL_SENDER_EMAIL=<your_account@gmail.com>
GMAIL_APP_PASSWORD=<16_char_app_password>

# OPTIONAL: where the mail smoke tests deliver. Defaults to the sender.
# MAIL_TEST_RECIPIENT=<someone@elsewhere.com>

# ==============================================================================
# Supabase Auth Configuration
# ==============================================================================

# Project URL — also used to derive the JWKS endpoint for verifying JWTs
# (https://<ref>.supabase.co/auth/v1/.well-known/jwks.json).
# See docs/runbooks/HOW_TO_ADD_SUPABASE_AUTH.md
SUPABASE_URL=https://<your-project-ref>.supabase.co



