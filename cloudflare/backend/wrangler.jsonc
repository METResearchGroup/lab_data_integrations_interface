{
	"$schema": "node_modules/wrangler/config-schema.json",
	// workers.dev hostname. A later cutover can rename this Worker to ldi-api.
	// That rename changes the public host, the Access application, and the UI URL.
	"name": "ldi-api-preview",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-23",
	"workers_dev": true,
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": false,
			"destinations": ["ldi-preview-grafana-logs"]
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": false,
			"destinations": ["ldi-preview-grafana-traces"]
		}
	},
	// Cold start waits on image pull plus Python imports. The paid CPU cap has
	// to cover that wait's bookkeeping; the container's own CPU is billed apart
	// from this Worker limit.
	"limits": {
		"cpu_ms": 300000
	},
	// No spaces. backend/main.py splits on commas and does not trim.
	"vars": {
		"CORS_ORIGINS": "https://ldi-ui-preview.mind-technology-lab.workers.dev,http://localhost:3000,http://127.0.0.1:3000",
		"DEPLOYMENT_ENVIRONMENT": "cloudflare-preview",
		"OTEL_RESOURCE_ATTRIBUTES": "deployment.environment=cloudflare-preview"
	},
	"containers": [
		{
			"class_name": "ApiContainer",
			"image": "./Dockerfile",
			"image_build_context": "../..",
			"instance_type": "standard-1",
			"max_instances": 1,
			"observability": {
				"enabled": true
			}
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "API_CONTAINER",
				"class_name": "ApiContainer"
			}
		]
	},
	"exports": {
		"ApiContainer": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	}
}
